{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "openocd test",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "openocd.cfg",
                "-c", "init",
                "-c", "exit"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "openocd download",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "openocd.cfg",
                "-c", "init",
                "-c", "reset halt",
                "-c", "flash write_image erase build_old/ODriveFirmware.elf",
                "-c", "reset run",
                "-c", "exit"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
    ]
}
